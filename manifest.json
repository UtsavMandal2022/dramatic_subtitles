{
  "manifest_version": 3,
  "name": "Dramatic Subtitles",
  "version": "0.1.0",
  "description": "Turns Netflix subtitles into dramatic, animated, reels-style captions — a different look for every line.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.netflix.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://*.netflix.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.netflix.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/content/netflix-selectors.js",
        "src/content/style-engine.js",
        "src/content/native-caption-hider.js",
        "src/content/overlay-renderer.js",
        "src/content/cue-watcher.js",
        "src/content/content.js"
      ],
      "css": [
        "styles/overlay.css",
        "styles/animations.css",
        "styles/hide-native-captions.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
